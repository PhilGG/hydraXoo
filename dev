#!/usr/bin/env bash
# Run development tasks inside Docker. Only Docker is needed on the host.
#   ./dev build    build the development image
#   ./dev test     run the test suite (extra args are passed to pytest)
#   ./dev lint     check code style
#   ./dev format   fix code style
#   ./dev shell    open a shell in the container
#   ./dev card     install, test and build the Lovelace card
#   ./dev card-test / card-build   one step only
set -euo pipefail
cd "$(dirname "$0")"

run() { docker compose run --rm dev "$@"; }

case "${1:-}" in
  build)  docker compose build ;;
  test)   shift; run pytest -p no:cacheprovider "$@" ;;
  lint)   run sh -c "ruff check . && ruff format --check ." ;;
  format) run sh -c "ruff format . ; ruff check --fix ." ;;
  shell)  run bash ;;
  card)   docker compose run --rm node sh -c "npm install --no-audit --no-fund && npx tsc --noEmit && npm test && npm run build" ;;
  card-test)  docker compose run --rm node sh -c "npm install --no-audit --no-fund >/dev/null && npm test" ;;
  card-build) docker compose run --rm node sh -c "npm install --no-audit --no-fund >/dev/null && npm run build" ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
